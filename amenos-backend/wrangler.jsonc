{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amenos-portfolio",
  "main": "worker.mjs",
  "compatibility_date": "2025-11-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    {"name":"VISITOR_LIMIT","namespace_id":"1001","simple":{"limit":8,"period":60}},
    {"name":"SITE_LIMIT","namespace_id":"1002","simple":{"limit":45,"period":60}}
  ]
}
